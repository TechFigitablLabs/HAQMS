// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DOCTOR
  RECEPTIONIST
}

enum AppointmentStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum QueueStatus {
  WAITING
  CALLING
  COMPLETED
  SKIPPED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(RECEPTIONIST)
  createdAt DateTime @default(now())

  doctor Doctor?
}

// FIXED: Unique constraint on (doctorId, appointmentDate) added to Appointment model
// to prevent double-booking the same physician at the same time slot.
model Doctor {
  id              String   @id @default(uuid())
  userId          String?  @unique
  user            User?    @relation(fields: [userId], references: [id])
  name            String
  specialization  String
  department      String
  consultationFee Float
  experience      Int
  availableFrom   String   @default("09:00")
  availableTo     String   @default("17:00")
  createdAt       DateTime @default(now())

  appointments Appointment[]
  queueTokens  QueueToken[]

  // Indexes for search/filter queries on department and specialization
  @@index([department])
  @@index([specialization])
}

model Patient {
  id             String   @id @default(uuid())
  name           String
  email          String?
  phoneNumber    String
  age            Int
  gender         String
  medicalHistory String?  // Nullable — intentional crash trigger for frontend bug
  createdAt      DateTime @default(now())

  appointments Appointment[]
  queueTokens  QueueToken[]

  // Index for gender filter used in patient listing
  @@index([gender])
}

model Appointment {
  id              String            @id @default(uuid())
  patientId       String
  patient         Patient           @relation(fields: [patientId], references: [id])
  doctorId        String
  doctor          Doctor            @relation(fields: [doctorId], references: [id])
  appointmentDate DateTime
  reason          String            @default("")
  status          AppointmentStatus @default(PENDING)
  createdAt       DateTime          @default(now())

  queueTokens QueueToken[]

  // Prevent double-booking: one appointment per doctor per exact time slot
  @@unique([doctorId, appointmentDate])
  // Index on foreign key for patient lookups
  @@index([patientId])
  // Compound index for worklist queries filtering by doctor + status
  @@index([doctorId, status])
}

model QueueToken {
  id            String      @id @default(uuid())
  tokenNumber   Int
  patientId     String
  patient       Patient     @relation(fields: [patientId], references: [id])
  doctorId      String
  doctor        Doctor      @relation(fields: [doctorId], references: [id])
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  status        QueueStatus @default(WAITING)
  createdAt     DateTime    @default(now())

  // Race condition handled via interactive transaction with FOR UPDATE lock.
  @@index([doctorId, createdAt])
  @@index([status])
}
