generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  DOCTOR
  RECEPTIONIST
}

enum AppointmentStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum QueueStatus {
  WAITING
  CALLING
  COMPLETED
  SKIPPED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(RECEPTIONIST)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor Doctor?
}

model Doctor {
  id             String @id @default(uuid())
  userId         String? @unique
  user           User?   @relation(fields: [userId], references: [id])
  name           String
  specialization String
  department     String
  consultationFee Float
  experience      Int

  // FIX: Changed from String to Int (minutes since midnight).
  // Storing time as plain text ("09:00") has no DB-level validation and can't be
  // used in SQL range queries. Using Int removes ambiguity and is easy to convert:
  //   Display  : mins => `${Math.floor(m/60)}:${String(m%60).padStart(2,'0')}`
  //   Parse in : "09:30" => 9*60+30 = 570
  // 540 = 09:00, 1020 = 17:00
  availableFrom Int @default(540)
  availableTo   Int @default(1020)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]
  queueTokens  QueueToken[]

  @@index([department])
  @@index([specialization])
}

model Patient {
  id             String  @id @default(uuid())
  name           String
  email          String?
  phoneNumber    String  @unique
  age            Int
  gender         Gender
  medicalHistory String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]
  queueTokens  QueueToken[]
}

model Appointment {
  id              String            @id @default(uuid())
  patientId       String
  patient         Patient           @relation(fields: [patientId], references: [id])
  doctorId        String
  doctor          Doctor            @relation(fields: [doctorId], references: [id])
  appointmentDate DateTime
  reason          String            @default("")
  status          AppointmentStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  queueTokens QueueToken[]

  // Prevents double-booking the same doctor at the same datetime.
  @@unique([doctorId, appointmentDate])

  @@index([doctorId, status])
  @@index([patientId])
}

model QueueToken {
  id            String      @id @default(uuid())
  tokenNumber   Int
  patientId     String
  patient       Patient     @relation(fields: [patientId], references: [id])
  doctorId      String
  doctor        Doctor      @relation(fields: [doctorId], references: [id])
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  status        QueueStatus @default(WAITING)

  // FIX: Changed @default(now()) to @default(dbgenerated("CURRENT_DATE")).
  // Using now() stored time as well as date, meaning two tokens created on the
  // same day had different queueDate values (2026-05-29 09:01 vs 2026-05-29 14:33).
  // The @@unique constraint on (doctorId, tokenNumber, queueDate) therefore never
  // matched, allowing duplicate token numbers across the same day.
  // CURRENT_DATE returns the date part only (no time), so all tokens for a given
  // calendar day share the exact same queueDate value.
  //
  // In app code, set explicitly: new Date(new Date().setHours(0, 0, 0, 0))
  queueDate DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prevents duplicate token numbers for the same doctor on the same calendar day.
  @@unique([doctorId, tokenNumber, queueDate])

  @@index([doctorId, queueDate])
  @@index([status])
}
