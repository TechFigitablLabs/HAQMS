# Copy this file to .env and fill in your values
NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/haqms?schema=public"
# REQUIRED: Use a strong, random secret (e.g. openssl rand -base64 64)
JWT_SECRET=replace-this-with-a-strong-random-secret-at-least-64-chars
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000
