    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "prisma": "5.22.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "engines": {
    "node": ">=18"
  }
}
