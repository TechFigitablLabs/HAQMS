{
  "name": "haqms-backend",
  "version": "1.0.0",
  "description": "Hospital Appointment and Queue Management System API",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:prod": "node scripts/start-prod.js",
    "postinstall": "prisma generate",
    "dev": "nodemon src/index.js",
